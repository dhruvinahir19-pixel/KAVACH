# KAVACH scanner - secrets contract (phases P1+). Copy to .env and fill. NEVER commit .env.
# On Render: set these as secret environment variables, not files.

# Telegram (create bot via @BotFather, then send /start to it from your account)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Upstox - 1-year Analytics token (read-only; ONE per account; regenerating revokes the old)
UPSTOX_ACCESS_TOKEN=
UPSTOX_TOKEN_GENERATED=    # YYYY-MM-DD - for T-30-day expiry alerts

# Neon Postgres (free project; connection string from the Neon dashboard)
NEON_DATABASE_URL=

# Ops
TRIGGER_SECRET=            # shared secret required in X-Trigger-Secret header on /trigger
TZ=Asia/Kolkata
